rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    match /rooms/{roomId} {
      allow read: if isSignedIn() && isValidId(roomId);
      allow create: if isSignedIn() && isValidId(roomId);
      allow update: if isSignedIn() && isValidId(roomId);
      allow delete: if isSignedIn() && isValidId(roomId) && (resource.data.hostId == request.auth.uid);

      match /messages/{messageId} {
        allow read: if isSignedIn() && isValidId(roomId) && isValidId(messageId);
        allow create: if isSignedIn() && isValidId(roomId) && isValidId(messageId);
      }
    }
  }
}
